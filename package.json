{
    "name": "domain-watcher",
    "private": true,
    "version": "1.1.1",
    "type": "module",
    "engines": {
        "node": ">=22.17"
    },
    "description": "Domain availability watcher built with SvelteKit",
    "author": {
        "name": "Nik Klemenc",
        "url": "https://klemenc.si"
    },
    "homepage": "https://klemenc.si",
    "repository": {
        "type": "git",
        "url": "https://github.com/Scorpio3310/domain-watcher"
    },
    "license": "MIT",
    "keywords": [
        "domain",
        "watcher",
        "monitor",
        "checker",
        "svelte",
        "sveltekit",
        "cloudflare"
    ],
    "scripts": {
        "dev": "vite dev",
        "postbuild": "node src/lib/cloudflare/postbuild.js",
        "build": "vite build",
        "preview": "wrangler dev --test-scheduled",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch"
    },
    "devDependencies": {
        "@iconify/svelte": "^5.2.2",
        "@sveltejs/adapter-cloudflare": "^8.0.1",
        "@sveltejs/kit": "^3.1.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.4",
        "wrangler": "^4.151.1",
        "zod": "^4.6.7"
    },
    "dependencies": {
        "@fontsource/figtree": "^5.3.0",
        "@whoisjson/whoisjson": "^1.0.4",
        "date-fns": "^4.4.0",
        "resend": "^6.34.1"
    },
    "imports": {
        "#lib/*": "./src/lib/*",
        "#components/*": "./src/components/*",
        "#src/*": "./src/*"
    }
}
