{
    // Cloudflare Worker application name
    "name": "check-watcher-private",

    // Main application entry point
    "main": ".svelte-kit/cloudflare/worker.mjs", // Changed due to adding Cron Job functionality - see src/lib/cloudflare/postbuild.js for details

    // Cloudflare Workers runtime API version
    "compatibility_date": "2025-08-03",

    // Node.js AsyncLocalStorage support - required by SvelteKit remote functions (async server features)
    "compatibility_flags": ["nodejs_als"],

    // Configuration for serving static files (CSS, JS, images)
    "assets": {
        "binding": "ASSETS", // Binding name for code access
        "directory": ".svelte-kit/cloudflare" // Directory with static files
    },

    // LOCAL DEVELOPMENT CONFIGURATION
    // Used by `wrangler dev` / `pnpm preview` only, never in production.
    // There is intentionally no "vars" block: CRON_SECRET and ADMIN_PASSWORD are runtime
    // secrets. `wrangler dev` reads them from .env (or from .dev.vars, which then replaces
    // .env completely), so the cron handler (env.CRON_SECRET) and /api/cron ($app/env/private)
    // always see the same value. Keep secrets out of this file - top-level "vars" would also
    // make wrangler ask to copy them into "env.production.vars" on every production deploy.
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "local-domain-watcher",
            "database_id": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
        }
    ],
    "services": [
        {
            "binding": "SELF_LOCAL", // Binding name / in lib/cloudflare/cron.js used as env.SELF (...if (env.SELF) {...)
            "service": "domain-watcher" // Service name (must match "name")
        }
    ],
    "triggers": {
        "crons": ["* * * * *"] // Every minute
    },

    // PRODUCTION ENVIRONMENT CONFIGURATION
    // This section is used for production deployment
    // It contains the database and service bindings
    // that are different from the development environment.
    // Make sure to replace the database_id with your actual production database ID.
    // This section is not used in local development.
    // It is only used when deploying to Cloudflare Workers.
    "env": {
        "production": {
            // Runtime secrets are NOT configured here - set them once with:
            //   npx wrangler secret put CRON_SECRET --env production     (secure random string, 32+ characters)
            //   npx wrangler secret put ADMIN_PASSWORD --env production  (password for the browser login prompt)
            // Secrets survive deploys; a "vars" entry with the same name would conflict with them.
            // The D1 binding (DB) of this private Worker is configured in the Cloudflare
            // dashboard, so its database ID stays out of the public repository.
            // Service bindings - allows worker to call itself
            "services": [
                {
                    "binding": "SELF", // Binding name / in cron.js used as env.SELF (...if (env.SELF) {...)
                    "service": "check-watcher-private" // Service name (must match "name")
                }
            ],
            // Cron Jobs - automated task scheduling - in lib/cloudflare/cron.js
            "triggers": {
                "crons": ["* * * * *"] // Every minute
            },
            // Cloudflare Worker application name
            "name": "check-watcher-private"
        }
    },

    // Monitoring and logging
    "observability": {
        "enabled": true, // Enable monitoring
        "head_sampling_rate": 1 // 100% sampling rate for complete logging
    }
}
